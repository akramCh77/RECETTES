# Étape de build
FROM node:18-alpine as build

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

RUN npm ci --legacy-peer-deps && \
    npm install jspdf-autotable && \
    rm -rf /root/.npm
# Copier le reste du code source
COPY . .

# Construire l'application pour la production
# Build avec flags pour forcer les dépendances
RUN npm run build || { echo "Build failed - retrying with force"; npm rebuild && npm run build; }

# Étape de production
FROM nginx:alpine

# Copier la build de l'étape précédente dans le dossier de nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copier la configuration nginx si elle existe (version simplifiée)
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf

# Exposer le port 80
EXPOSE 80

# Démarrer nginx
CMD ["nginx", "-g", "daemon off;"]